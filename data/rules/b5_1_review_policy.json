      "required_context_keys": [
        "entity",
        "reporting_date",
        "accounting_scope",
        "currency"
      ],
      "notes": "Fact alignment is required; the parent-only StockholdersEquity tag cannot automatically stand for total equity including noncontrolling interests.",
